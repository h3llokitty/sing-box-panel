# Справочный шаблон. install.sh спросит эти значения интерактивно
# и сам создаст /etc/sing-box/vpn-panel.env — редактировать этот файл не нужно,
# разве что для ручной правки уже существующей установки.

A_IP="ВАШ_IP_СЕРВЕРА_A"
A_DOMAIN="ваш-домен.example.com"
ACME_EMAIL="you@example.com"
WG_PORT=51820
WG_NET="10.10.0"
HY2_PORT=443
B_DOMAIN="сервер-b.example.com"
B_PORT=443
B_PASS="ПАРОЛЬ_HY2_НА_СЕРВЕРЕ_B"
PROFILE_HOST="ваш-домен.example.com"
PROFILE_PORT=8443
VLESS_PORT=443
VLESS_DEST="ozon.ru"
VLESS_SNI="ozon.ru"
AVAILABLE_PROXY_TYPES="hy2 vless"
# Optional local Cloudflare WARP SOCKS outbound; routing is selected in service menu 5 -> 6.
WARP_ENABLED=0
WARP_PORT=40000
WARP_TAG="WARP"
# Optional standard Russian-resource policy: .ru/.su/.рф/.xn--p1ai and geoip-ru.
RU_RULES_ENABLED=0
# Base URL containing geoip/ and geosite/ directories. Used only when RU_RULES_ENABLED=1.
RULESET_BASE_URL="https://unicorns.kz/sources"
